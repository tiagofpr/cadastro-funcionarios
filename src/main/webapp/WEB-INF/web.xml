<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>ListarFuncionarioServlet</servlet-name>
        <servlet-class>br.com.tiagoribeiro.controller.ListarFuncionarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ListarFuncionarioServlet</servlet-name>
        <url-pattern>/funcionarios</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>SalvarFuncionarioServlet</servlet-name>
        <servlet-class>br.com.tiagoribeiro.controller.SalvarFuncionarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalvarFuncionarioServlet</servlet-name>
        <url-pattern>/funcionarios/novo</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>DeletarFuncionarioServlet</servlet-name>
        <servlet-class>br.com.tiagoribeiro.controller.DeletarFuncionarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeletarFuncionarioServlet</servlet-name>
        <url-pattern>/funcionarios/deletar</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>EditarFuncionarioServlet</servlet-name>
        <servlet-class>br.com.tiagoribeiro.controller.EditarFuncionarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditarFuncionarioServlet</servlet-name>
        <url-pattern>/funcionarios/editar</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>br.com.tiagoribeiro.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RequestLoggingFilter</filter-name>
        <filter-class>br.com.tiagoribeiro.filter.RequestLoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestLoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
